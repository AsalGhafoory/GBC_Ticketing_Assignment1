@model GBC_Ticketing.Models.Event

<h2>Edit Event</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="EventId" />

    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label>Date & Time</label>
        <input asp-for="DateTime" type="datetime-local" class="form-control" />
    </div>

    <div class="form-group">
        <label>Ticket Price</label>
        <input asp-for="TicketPrice" class="form-control" />
    </div>

    <div class="form-group">
        <label>Available Tickets</label>
        <input asp-for="AvailableTickets" class="form-control" />
    </div>

    <div class="form-group">
        <label>Category</label>
        <select asp-for="CategoryId" class="form-control">
            @foreach (var cat in ViewBag.Categories)
            {
                <option value="@cat.CategoryId"
                        selected="@(cat.CategoryId == Model.CategoryId)">
                    @cat.Name
                </option>
            }
        </select>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
